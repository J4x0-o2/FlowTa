CREATE TABLE IF NOT EXISTS goal (
    id             TEXT    NOT NULL PRIMARY KEY,
    name           TEXT    NOT NULL,
    target_amount  REAL    NOT NULL,
    current_amount REAL    NOT NULL DEFAULT 0.0,
    mode           TEXT    NOT NULL,
    periodicity    TEXT    NOT NULL,
    deadline       INTEGER,
    created_at     INTEGER NOT NULL
);

-- mode: SAVINGS | SAVINGS_FOR_EXPENSE
-- periodicity: DAILY | WEEKLY | BIWEEKLY | MONTHLY | BIMONTHLY | QUARTERLY | SEMIANNUAL

selectAll:
SELECT * FROM goal ORDER BY created_at DESC;

selectById:
SELECT * FROM goal WHERE id = ?;

insert:
INSERT INTO goal(id, name, target_amount, current_amount, mode, periodicity, deadline, created_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?);

updateCurrentAmount:
UPDATE goal SET current_amount = current_amount + ? WHERE id = ?;

delete:
DELETE FROM goal WHERE id = ?;

selectNearDeadline:
SELECT * FROM goal
WHERE deadline IS NOT NULL
  AND deadline <= ?
  AND current_amount < target_amount;

-- Takes back (floor 0) what an account contributed, before its contributions are deleted.
subtractAccountContributions:
UPDATE goal
SET current_amount = MAX(0.0, current_amount - COALESCE(
    (SELECT SUM(amount) FROM goal_contribution
     WHERE goal_id = goal.id AND from_account_id = :accountId), 0.0))
WHERE id IN (SELECT goal_id FROM goal_contribution WHERE from_account_id = :accountId);

deleteAll:
DELETE FROM goal;
